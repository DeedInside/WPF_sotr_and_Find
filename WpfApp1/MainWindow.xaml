<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal">
            <TextBox Name="TextBoxFind" Width="150" KeyUp="TextBox_select_to_Name_KeyUp"/>
            <ComboBox Name="ComboBoxFind" SelectedIndex="0" SelectionChanged="ComboBoxFind_Selected">
                <ComboBoxItem>Name</ComboBoxItem>
                <ComboBoxItem>Email</ComboBoxItem>
                <ComboBoxItem>Valid</ComboBoxItem>
            </ComboBox>
        </StackPanel>
        <ComboBox Name="ComboBoxSort" SelectedIndex="0" SelectionChanged="ComboBoxSort_SelectionChanged">
            <ComboBoxItem>Name</ComboBoxItem>
            <ComboBoxItem>Email</ComboBoxItem>
            <ComboBoxItem>Valid</ComboBoxItem>
        </ComboBox>
        <ListView Name="ListViewUser" >
            <ListView.View>
                <GridView>
                    <GridViewColumn DisplayMemberBinding="{Binding Name}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader  Content="Name"/>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Header="Email" DisplayMemberBinding="{Binding Email}"/>
                    <GridViewColumn Header="Valid" DisplayMemberBinding="{Binding IsValid}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </StackPanel>
</Window>
