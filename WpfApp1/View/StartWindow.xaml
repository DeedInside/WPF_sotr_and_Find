<Window x:Class="WpfApp1.View.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.View"
        mc:Ignorable="d"
        Title="StartWindow" Height="450" Width="800">
    <StackPanel>
        <ListView ItemsSource="{Binding Items}" SelectedItem="{Binding SelectesViewItem}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Price" DisplayMemberBinding="{Binding Price}"/>
                    <GridViewColumn Header="Valid" DisplayMemberBinding="{Binding IsValid}"/>
                    <GridViewColumn Header="Discount" DisplayMemberBinding="{Binding Discount}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <Button Margin="5" Content="Добавить новый инвентарь" Click="Add_New_Item_Click"/>
        <Button Margin="5" Content="Удалить выбранный инвентарь" Click="Remove_Item_Click"/>
        <Button Margin="5" Content="Привязать пользователя к инвентарю" Click="Binding_User_To_Item_Click"/>

    </StackPanel>
</Window>
