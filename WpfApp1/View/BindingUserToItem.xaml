<Window x:Class="WpfApp1.View.BindingUserToItem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.View"
        mc:Ignorable="d"
        Title="BindingUserToItem" Height="250" Width="200">
    <StackPanel>
        <ListView ItemsSource="{Binding Users}"
                  SelectedItem="{Binding SelectUser}"
                  MinHeight="120" Margin="15"/>
        <StackPanel Orientation="Horizontal" Margin="15" HorizontalAlignment="Center">
            <Button Margin="0 0 15 0" Content="Добавить" Click="Add_Click"/>
            <Button Content="Отмена" Click="Cloce_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
