<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel>
        <ListView Name="ListViewUsers" ItemsSource="{Binding Users}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name User" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Email" DisplayMemberBinding="{Binding Email}"/>
                    <GridViewColumn Header="Valid" DisplayMemberBinding="{Binding IsValid}"/>
                    <GridViewColumn Header="Role" DisplayMemberBinding="{Binding Role.Name}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <Button Content="add new user" Click="Add_User_Click"/>
        <Button Content="Edit user" Click="Edit_user_Click"/>
        <Button Content="Remove user" Click="Remove_User_Click"/>
        <ListView Name="ListViewRole"/>
        <Button Content="Выдать роль" Click="Add_Role_to_User_Click"/>
    </StackPanel>
</Window>
