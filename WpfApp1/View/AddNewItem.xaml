<Window x:Class="WpfApp1.View.AddNewItem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.View"
        mc:Ignorable="d"
        Title="AddNewItem" Height="250" Width="300">
    <StackPanel>
        <StackPanel Margin="15 15 0 0" Orientation="Horizontal">
            <TextBox Name="boxName" MinWidth="120"/>
            <Label Content="название инветоря"/>
        </StackPanel>
        <StackPanel Margin="15 15 0 0" Orientation="Horizontal">
            <TextBox Name="boxDescription" MinWidth="120"/>
            <Label Content="Описание"/>
        </StackPanel>
        <StackPanel Margin="15 15 0 0" Orientation="Horizontal">
            <TextBox Name="boxSize" MinWidth="120"/>
            <Label Content="Размер"/>
        </StackPanel>
        <StackPanel Margin="15 15 0 0" Orientation="Horizontal">
            <TextBox Name="boxPrice" MinWidth="120"/>
            <Label Content="Цена"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="15" HorizontalAlignment="Center">
            <Button Margin="0 0 15 0" Content="Добавить" Click="Add_Click"/>
            <Button Content="Отмена" Click="Cloce_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
