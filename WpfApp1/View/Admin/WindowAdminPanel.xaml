<Window x:Class="WpfApp1.View.Admin.WindowAdminPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.View.Admin"
        mc:Ignorable="d"
        Title="WindowAdminPanel" Height="450" Width="800">
    <StackPanel>
        <ListView Name="ViewItems">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Id" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}"/>
                    <GridViewColumn Header="Size" DisplayMemberBinding="{Binding Size}"/>
                    <GridViewColumn Header="Price" DisplayMemberBinding="{Binding Price}"/>
                    <GridViewColumn Header="Valid" DisplayMemberBinding="{Binding IsValid}"/>
                    <GridViewColumn Header="Discount" DisplayMemberBinding="{Binding Discount}"/>
                    <GridViewColumn Header="User id" DisplayMemberBinding="{Binding Client.Id}"/>
                    <GridViewColumn Header="User name" DisplayMemberBinding="{Binding Client.Name}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <ListView Name="ViewUsers">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Id" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Email" DisplayMemberBinding="{Binding Email}"/>
                    <GridViewColumn Header="Password" DisplayMemberBinding="{Binding Password}"/>
                    <GridViewColumn Header="Role id" DisplayMemberBinding="{Binding Role.Id}"/>
                    <GridViewColumn Header="Role" DisplayMemberBinding="{Binding Role.Name}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <Button Content="Удалить пользователя" Click="Remove_User_Click"/>
    </StackPanel>
</Window>
