<Window x:Class="WpfApp1.View.CreateUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.View"
        mc:Ignorable="d"
        Title="CreateUserWindow" Height="250" Width="350">
    <StackPanel>
        <StackPanel Margin="2 2 2 2" Orientation="Horizontal">
            <TextBox Name="BoxName" MinWidth="150"/>
            <Label Content="Имя пользователя"/>
        </StackPanel>
        <StackPanel Margin="2 2 2 2" Orientation="Horizontal">
            <TextBox Name="BoxEmail" MinWidth="150"/>
            <Label Content="Email"/>
        </StackPanel>
        <StackPanel Margin="2 2 2 2" Orientation="Horizontal">
            <TextBox Name="BoxPass" MinWidth="150"/>
            <Label Content="Пароль"/>
        </StackPanel>
        <StackPanel Margin="2 2 2 2" Orientation="Horizontal">
            <CheckBox Name="CheckIsValid" VerticalAlignment="Center"/>
            <Label Content="Валидность"/>
        </StackPanel>
        <Button Content="Save" MinWidth="120" Click="Button_Click"/>
    </StackPanel>
</Window>
